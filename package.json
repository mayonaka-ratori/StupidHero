{
  "name": "stupid-hero",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build:page": "tsc --noEmit && EXTERNAL_FONT=1 vite build --outDir dist-page"
  },
  "dependencies": {
    "@fontsource/dotgothic16": "^5.3.0",
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "playwright-core": "1.56",
    "typescript": "^5.9.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
