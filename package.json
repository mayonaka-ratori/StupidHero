{
  "name": "stupid-hero",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build:page": "tsc --noEmit && vite build --mode page --outDir dist-page",
    "dashboard": "node --experimental-strip-types tools/dashboard.mjs"
  },
  "dependencies": {
    "@fontsource/dotgothic16": "^5.3.0",
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "playwright-core": "1.56",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.1"
  }
}
